{
  "name": "camshare",
  "version": "0.1.0",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/server.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "appId": "com.mhmdbrkv.camshare",
    "productName": "CamShare",
    "win": {
      "target": "nsis",
      "artifactName": "CamShare-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
